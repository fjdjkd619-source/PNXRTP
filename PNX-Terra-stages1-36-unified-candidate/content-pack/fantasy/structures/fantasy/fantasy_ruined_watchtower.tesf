// Ruined stone watchtower. Finite 7x7 footprint, 10-block height.
for (num y = 0; y <= 9; y = y + 1) {
    for (num x = -3; x <= 3; x = x + 1) {
        for (num z = -3; z <= 3; z = z + 1) {
            if (y == 0) {
                block(x, y, z, "minecraft:stone_bricks");
            } else if (x * x == 9 && z * z == 9) {
                if (x == -3 && z == -3) block(x, y, z, "minecraft:mossy_stone_bricks");
                else if (x == 3 && z == 3) block(x, y, z, "minecraft:cracked_stone_bricks");
                else block(x, y, z, "minecraft:stone_bricks");
            } else if (y == 9 && (x * x == 9 || z * z == 9)) {
                block(x, y, z, "minecraft:mossy_stone_bricks");
            }
        }
    }
}
