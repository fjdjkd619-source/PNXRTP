// Ruined stone watchtower. Finite 7x7 footprint, 10-block height.
for (num x = -3; x <= 3; x = x + 1) {
    for (num z = -3; z <= 3; z = z + 1) {
        block(x, 0, z, "minecraft:stone_bricks");
    }
}

for (num y = 1; y <= 8; y = y + 1) {
    block(-3, y, -3, "minecraft:mossy_stone_bricks");
    block(-3, y, 3, "minecraft:stone_bricks");
    block(3, y, -3, "minecraft:stone_bricks");
    block(3, y, 3, "minecraft:cracked_stone_bricks");
}

for (num x = -3; x <= 3; x = x + 1) {
    block(x, 9, -3, "minecraft:stone_bricks");
    block(x, 9, 3, "minecraft:mossy_stone_bricks");
}
for (num z = -2; z <= 2; z = z + 1) {
    block(-3, 9, z, "minecraft:stone_bricks");
    block(3, 9, z, "minecraft:stone_bricks");
}
