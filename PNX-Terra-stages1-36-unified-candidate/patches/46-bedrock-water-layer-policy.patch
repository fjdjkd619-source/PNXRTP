-    private PlacementGuardHost.PlacementScope scopeFor(PlacementTransaction transaction, boolean root) {
-        return new PlacementGuardHost.PlacementScope() {
-            private boolean finished;
-
-            @Override public boolean accepted() { return !finished && activePlacement == transaction; }
-
-            @Override
-            public boolean commit() {
-                ensureOwner();
-                if (finished) return false;
-                if (transaction.guard.snapshot().state() != PlacementRuntimeGuard.State.OPEN) {
-                    abort();
-                    return false;
-                }
-                if (!root) {
-                    transaction.parent.staged.merge(transaction.staged);
-                    transaction.parent.blockEntities.addAll(transaction.blockEntities);
-                    transaction.parent.physics.addAll(transaction.physics);
-                    finish();
-                    return true;
-                }
-                int anchorChunkX = transaction.originX >> 4;
-                int anchorChunkZ = transaction.originZ >> 4;
-                if (transaction.journalTicket == null) {
-                    // Legacy construction remains fail-closed until the PopulateStage journal service is supplied.
-                    if (!transaction.blockEntities.isEmpty() || !transaction.physics.isEmpty()) { abort(); return false; }
-                    for (Block block : transaction.staged.getBlocks()) {
-                        if (block.getChunkX() != anchorChunkX || block.getChunkZ() != anchorChunkZ) {
-                            abort();
-                            return false;
-                        }
-                    }
-                    level.merge(transaction.staged);
-                } else if (transaction.staged.getBlocks().isEmpty()
-                        && transaction.blockEntities.isEmpty() && transaction.physics.isEmpty()) {
-                    transaction.journalTicket.abort();
-                } else {
-                    // Durable WAL first. Only anchor-local writes enter this stage's BlockManager;
-                    // cross-chunk writes are left for the Stage18 journal applier after its barrier.
-                    try {
-                        PnxPlacementCommitter.commit(transaction.journalTicket, transaction.journalKey,
-                                transaction.staged, transaction.blockEntities, transaction.physics);
-                    } catch (IOException journalFailure) {
-                        diagnostics.publish(GenerationDiagnostic.failure("terra_populate", transaction.featureId,
-                                transaction.structureId, new ChunkPos(anchorChunkX, anchorChunkZ),
-                                transaction.originX, transaction.originY, transaction.originZ, journalFailure));
-                        abort();
-                        throw new IllegalStateException("Failed to durably commit Terra placement", journalFailure);
-                    }
-                    BlockManager anchorWrites = new BlockManager(level.getLevel());
-                    for (Block block : transaction.staged.getBlocks()) {
-                        if (block.getChunkX() == anchorChunkX && block.getChunkZ() == anchorChunkZ) {
-                            anchorWrites.setBlockStateAt(block.getFloorX(), block.getFloorY(), block.getFloorZ(),
-                                    block.layer, block.getBlockState());
-                        }
-                    }
-                    level.merge(anchorWrites);
-                }
-                transaction.guard.complete();
-                finish();
-                return true;
-            }
-
-            @Override
-            public void abort() {
-                ensureOwner();
-                if (finished) return;
-                if (root && transaction.guard.snapshot().state() != PlacementRuntimeGuard.State.COMPLETED) {
-                    transaction.guard.abort();
-                }
-                if (root && transaction.journalTicket != null) transaction.journalTicket.abort();
-                finish();
-            }
-
-            @Override public void close() { if (!finished) abort(); }
-
-            private void ensureOwner() {
-                if (Thread.currentThread() != transaction.owner) throw new IllegalStateException("Placement is thread-confined");
-                if (activePlacement != transaction) throw new IllegalStateException("Placement scopes must close LIFO");
-            }
-
-            private void finish() {
-                finished = true;
-                activePlacement = transaction.parent;
-                if (root) transaction.guardScope.close();
-            }
-        };
-    }
