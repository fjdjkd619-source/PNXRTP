-    private static int stagedInventorySize(Class<? extends org.powernukkitx.blockentity.BlockEntity> type) {
-        String name = type.getSimpleName().toLowerCase(java.util.Locale.ROOT);
-        if (name.contains("chest") || name.contains("barrel") || name.contains("shulker")) return 27;
-        if (name.contains("dispenser") || name.contains("dropper") || name.contains("crafter")) return 9;
-        if (name.contains("hopper")) return 5;
-        if (name.contains("brewingstand")) return 5;
-        if (name.contains("furnace") || name.contains("smoker")) return 3;
-        throw new UnsupportedOperationException("No safe Terra inventory size mapping for PNX BlockEntity " + type.getName());
-    }
