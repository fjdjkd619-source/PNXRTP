-    private PlacementTransaction requirePlacement() {
-        PlacementTransaction tx = activePlacement;
-        if (tx == null) throw new IllegalStateException("Terra block operation outside a guarded root placement");
-        if (Thread.currentThread() != tx.owner) throw new IllegalStateException("Placement accessed from another thread");
-        return tx;
-    }
