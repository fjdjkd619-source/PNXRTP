@@ -0,0 +1,28 @@
+package com.dfsek.terra.api.world;
+
+import com.dfsek.seismic.type.Rotation;
+import com.dfsek.seismic.type.vector.Vector3Int;
+
+/** Optional platform SPI for atomic, bounded feature placements. */
+public interface PlacementGuardHost {
+    PlacementScope beginPlacement(String featureId, String structureId, Vector3Int origin, Rotation rotation);
+
+    /** Opens a nested savepoint inside the currently active root placement. */
+    PlacementScope beginNestedPlacement(String structureId);
+
+    interface PlacementScope extends AutoCloseable {
+        boolean accepted();
+        boolean commit();
+        void abort();
+        @Override void close();
+
+        static PlacementScope rejected() {
+            return new PlacementScope() {
+                @Override public boolean accepted() { return false; }
+                @Override public boolean commit() { return false; }
+                @Override public void abort() { }
+                @Override public void close() { }
+            };
+        }
+    }
+}
