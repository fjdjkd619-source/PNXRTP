@@ -0,0 +1,142 @@
+package org.powernukkitx.terra.crosschunk.transaction;
+
+import org.powernukkitx.terra.crosschunk.CrossChunkOperation;
+import org.powernukkitx.terra.crosschunk.CrossChunkPlacementJournal;
+import org.powernukkitx.terra.crosschunk.PlacementKey;
+
+import java.io.IOException;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Deque;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Bridges Terra's nested placement scopes to the durable cross-chunk journal.
+ *
+ * A root placement is the atomic journal unit. Nested structure scopes are
+ * savepoints: commit merges their writes into the parent; abort discards them.
+ * Only committing the root writes one complete placement frame to the WAL.
+ *
+ * Instances are intended to be owned by one generation context. A thread-local
+ * stack isolates concurrent generation workers; a scope must be closed on the
+ * same thread and in strict LIFO order.
+ */
+public final class PlacementTransactionCoordinator<S> {
+    @FunctionalInterface
+    public interface StateEncoder<S> {
+        byte[] encode(S state) throws IOException;
+    }
+
+    private final CrossChunkPlacementJournal journal;
+    private final StateEncoder<S> encoder;
+    private final ThreadLocal<Deque<Scope>> scopes = ThreadLocal.withInitial(ArrayDeque::new);
+
+    public PlacementTransactionCoordinator(CrossChunkPlacementJournal journal, StateEncoder<S> encoder) {
+        this.journal = Objects.requireNonNull(journal, "journal");
+        this.encoder = Objects.requireNonNull(encoder, "encoder");
+    }
+
+    /** Opens a root placement or a nested savepoint belonging to that root. */
+    public Scope begin(PlacementKey key, int priority, CrossChunkOperation.ConflictPolicy policy) {
+        Objects.requireNonNull(key, "key");
+        Objects.requireNonNull(policy, "policy");
+        Deque<Scope> stack = scopes.get();
+        Scope parent = stack.peek();
+        // A nested Terra structure has its own descriptor, but remains part of
+        // the root placement's atomic journal frame. The root key is inherited.
+        Scope scope = new Scope(parent, parent == null ? key : parent.key,
+                parent == null ? priority : parent.priority,
+                parent == null ? policy : parent.policy);
+        stack.push(scope);
+        return scope;
+    }
+
+    public boolean hasOpenScope() {
+        return !scopes.get().isEmpty();
+    }
+
+    /** Fails closed if a generator stage exits while a scope remains open. */
+    public void assertNoOpenScopes() {
+        Deque<Scope> stack = scopes.get();
+        if (!stack.isEmpty()) {
+            throw new IllegalStateException("Generation ended with " + stack.size() + " unclosed placement scope(s)");
+        }
+        scopes.remove();
+    }
+
+    public final class Scope implements AutoCloseable {
+        private final Scope parent;
+        private final PlacementKey key;
+        private final int priority;
+        private final CrossChunkOperation.ConflictPolicy policy;
+        private final List<PendingWrite<S>> writes = new ArrayList<>();
+        private final Thread owner = Thread.currentThread();
+        private boolean closed;
+
+        private Scope(Scope parent, PlacementKey key, int priority, CrossChunkOperation.ConflictPolicy policy) {
+            this.parent = parent;
+            this.key = key;
+            this.priority = priority;
+            this.policy = policy;
+        }
+
+        public void write(int x, int y, int z, int layer, S state) {
+            requireTopAndOpen();
+            if (layer < 0 || layer > 1) throw new IllegalArgumentException("PNX block layer must be 0 or 1");
+            writes.add(new PendingWrite<>(x, y, z, layer, Objects.requireNonNull(state, "state")));
+        }
+
+        /** Commits this savepoint; only the root commit reaches durable storage. */
+        public void commit() throws IOException {
+            requireTopAndOpen();
+            Deque<Scope> stack = scopes.get();
+            if (parent != null) {
+                // Savepoint commit is an in-memory merge only. A parent abort
+                // still discards every write made by this nested structure.
+                parent.writes.addAll(writes);
+            } else {
+                // Encode and durably append BEFORE popping/closing the root.
+                // If encoding or WAL I/O fails, the scope remains open and can
+                // be retried or explicitly aborted; no half-commit is exposed.
+                List<CrossChunkOperation> operations = new ArrayList<>(writes.size());
+                int ordinal = 0;
+                for (PendingWrite<S> write : writes) {
+                    byte[] payload = Objects.requireNonNull(encoder.encode(write.state()), "encoder returned null payload");
+                    operations.add(new CrossChunkOperation(write.x(), write.y(), write.z(), write.layer(),
+                            priority, policy, key, ordinal++, payload));
+                }
+                journal.append(key, operations);
+            }
+            stack.pop();
+            closed = true;
+            cleanup(stack);
+        }
+
+        /** Discards this scope and all of its writes without touching the WAL. */
+        public void abort() {
+            requireTopAndOpen();
+            Deque<Scope> stack = scopes.get();
+            stack.pop();
+            writes.clear();
+            closed = true;
+            cleanup(stack);
+        }
+
+        @Override public void close() {
+            if (!closed) abort();
+        }
+
+        private void requireTopAndOpen() {
+            if (Thread.currentThread() != owner) throw new IllegalStateException("Placement scope is thread-confined");
+            if (closed) throw new IllegalStateException("Placement scope is already closed");
+            if (scopes.get().peek() != this) throw new IllegalStateException("Placement scopes must close in LIFO order");
+        }
+    }
+
+    private void cleanup(Deque<Scope> stack) {
+        if (stack.isEmpty()) scopes.remove();
+    }
+
+    private record PendingWrite<S>(int x, int y, int z, int layer, S state) {}
+}
diff --git a/src/test/java/org/powernukkitx/terra/crosschunk/transaction/PlacementTransactionCoordinatorTest.java b/src/test/java/org/powernukkitx/terra/crosschunk/transaction/PlacementTransactionCoordinatorTest.java
new file mode 100644
index 0000000..ee6de33
--- /dev/null
+++ b/src/test/java/org/powernukkitx/terra/crosschunk/transaction/PlacementTransactionCoordinatorTest.java
@@ -0,0 +1,75 @@
+package org.powernukkitx.terra.crosschunk.transaction;
+
+import org.powernukkitx.terra.crosschunk.CrossChunkOperation;
+import org.powernukkitx.terra.crosschunk.CrossChunkPlacementJournal;
+import org.powernukkitx.terra.crosschunk.PlacementKey;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+public final class PlacementTransactionCoordinatorTest {
+    public static void main(String[] args) throws Exception {
+        Path dir = Files.createTempDirectory("pnx-terra-stage9-");
+        Path wal = dir.resolve("placements.wal");
+        PlacementKey key = PlacementKey.create(77L, "overworld", "castle_feature", "castle", 31, 70, -9, 0, "root");
+        try (CrossChunkPlacementJournal journal = new CrossChunkPlacementJournal(wal)) {
+            PlacementTransactionCoordinator<String> coordinator = new PlacementTransactionCoordinator<>(journal,
+                    value -> value.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            try (var root = coordinator.begin(key, 40, CrossChunkOperation.ConflictPolicy.EXCLUSIVE)) {
+                root.write(31, 70, -9, 0, "stone");
+                PlacementKey nestedDescriptorKey = PlacementKey.create(77L, "overworld", "castle_feature", "inner_tower", 32, 70, -9, 1, "root/inner");
+                try (var nested = coordinator.begin(nestedDescriptorKey, 999, CrossChunkOperation.ConflictPolicy.ALLOW)) {
+                    nested.write(32, 70, -9, 0, "brick");
+                    nested.commit();
+                }
+                try (var aborted = coordinator.begin(key, 40, CrossChunkOperation.ConflictPolicy.EXCLUSIVE)) {
+                    aborted.write(33, 70, -9, 0, "must-not-appear");
+                    aborted.abort();
+                }
+                check(journal.operationsForChunk(1, -1).isEmpty(), "nested commit must not publish before root commit");
+                root.commit();
+            }
+            coordinator.assertNoOpenScopes();
+            List<CrossChunkOperation> west = journal.operationsForChunk(1, -1);
+            List<CrossChunkOperation> east = journal.operationsForChunk(2, -1);
+            check(west.size() == 1 && east.size() == 1, "root commit must atomically publish writes across both target chunks");
+            check(west.get(0).ordinal() != east.get(0).ordinal(), "ordinals must be unique across the root placement");
+            check(east.get(0).priority() == 40 && east.get(0).policy() == CrossChunkOperation.ConflictPolicy.EXCLUSIVE,
+                    "nested descriptor must not override root priority or conflict policy");
+            check(!new String(west.get(0).statePayload(), java.nio.charset.StandardCharsets.UTF_8).contains("must-not-appear")
+                    && !new String(east.get(0).statePayload(), java.nio.charset.StandardCharsets.UTF_8).contains("must-not-appear"),
+                    "aborted nested writes must not be journaled");
+        }
+        try (CrossChunkPlacementJournal recovered = new CrossChunkPlacementJournal(wal)) {
+            check(recovered.operationsForChunk(1, -1).size() == 1
+                    && recovered.operationsForChunk(2, -1).size() == 1, "cross-chunk root placement must survive journal recovery");
+            check(recovered.operationsForChunk(2, -1).get(0).placementKey().equals(key),
+                    "nested descriptor must inherit the root placement identity");
+        }
+        Path failedWal = dir.resolve("failed-encode.wal");
+        try (CrossChunkPlacementJournal journal = new CrossChunkPlacementJournal(failedWal)) {
+            PlacementTransactionCoordinator<String> failing = new PlacementTransactionCoordinator<>(journal, value -> {
+                throw new java.io.IOException("synthetic codec failure");
+            });
+            var scope = failing.begin(key, 1, CrossChunkOperation.ConflictPolicy.ALLOW);
+            scope.write(0, 64, 0, 0, "bad");
+            boolean failed = false;
+            try { scope.commit(); } catch (java.io.IOException expected) { failed = true; }
+            check(failed && failing.hasOpenScope(), "failed encoding must leave root scope open for explicit abort/retry");
+            scope.abort();
+            failing.assertNoOpenScopes();
+            check(journal.operationsForChunk(0, 0).isEmpty(), "failed encoding must not publish a partial journal frame");
+            var abortedRoot = failing.begin(key, 1, CrossChunkOperation.ConflictPolicy.ALLOW);
+            abortedRoot.write(1, 64, 1, 0, "discard-root");
+            abortedRoot.abort();
+            check(journal.operationsForChunk(0, 0).isEmpty() && journal.operationsForChunk(0, 0).isEmpty(),
+                    "root abort must publish no journal operations");
+        }
+        System.out.println("PASS: nested savepoint commit, abort isolation, root atomic publication, identity/policy inheritance, failed-encode rollback, root abort, WAL recovery");
+    }
+
+    private static void check(boolean condition, String message) {
+        if (!condition) throw new AssertionError(message);
+    }
+}
