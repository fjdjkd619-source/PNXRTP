+    /**
+     * Applies the currently committed journal snapshot directly to the supplied
+     * chunk. This is the generation-stage path: it never loads neighbouring
+     * chunks and deliberately does not acknowledge persistence. The ordinary
+     * PNX chunk-save lifecycle must finish before AppliedChunkLedger is updated
+     * by the later persistence integration stage.
+     */
+    public int applyAvailableToChunk(IChunk chunk) throws IOException {
+        Objects.requireNonNull(chunk, "chunk");
+        ChunkPos target = new ChunkPos(chunk.getX(), chunk.getZ());
+        List<CrossChunkOperation> snapshot = journal.operationsForChunk(target.x(), target.z());
+        if (snapshot.isEmpty()) return 0;
+
+        Map<BlockLayer, List<CrossChunkOperation>> candidates = new HashMap<>();
+        for (CrossChunkOperation operation : snapshot) {
+            if (operation.targetChunkX() != target.x() || operation.targetChunkZ() != target.z()) {
+                throw new IOException("Journal returned operation for the wrong target chunk");
+            }
+            if (operation.y() < chunk.getDimensionData().getMinHeight()
+                    || operation.y() > chunk.getDimensionData().getMaxHeight()) {
+                throw new IOException("Journal operation is outside dimension height: " + operation.y());
+            }
+            candidates.computeIfAbsent(new BlockLayer(operation.x(), operation.y(), operation.z(), operation.layer()),
+                    ignored -> new ArrayList<>()).add(operation);
+        }
+
+        synchronized (chunk) {
+            if (level.getChunkIfLoaded(target.x(), target.z()) != chunk) {
+                throw new IOException("Target chunk is no longer loaded: " + target);
+            }
+            int applied = 0;
+            List<Map.Entry<BlockLayer, List<CrossChunkOperation>>> ordered = new ArrayList<>(candidates.entrySet());
+            ordered.sort(Map.Entry.comparingByKey(Comparator.comparingInt(BlockLayer::x)
+                    .thenComparingInt(BlockLayer::y).thenComparingInt(BlockLayer::z)
+                    .thenComparingInt(BlockLayer::layer)));
+            for (var entry : ordered) {
+                BlockLayer position = entry.getKey();
+                int localX = position.x() & 15;
+                int localZ = position.z() & 15;
+                BlockState baseState = chunk.getBlockState(localX, position.y(), localZ, position.layer());
+                Block baseBlock = Block.get(baseState, level, position.x(), position.y(), position.z(), position.layer());
+                var winner = CrossChunkPlacementJournal.resolveWinner(entry.getValue(), replaceable.test(baseBlock));
+                if (winner.isEmpty()) continue;
+                BlockState targetState = PnxBlockStatePayloadCodec.decode(winner.get().statePayload());
+                chunk.setBlockState(localX, position.y(), localZ, targetState, position.layer());
+                applied++;
+            }
+            if (applied > 0) {
+                chunk.recalculateHeightMap();
+                chunk.setChanged();
+            }
+            return applied;
+        }
+    }
