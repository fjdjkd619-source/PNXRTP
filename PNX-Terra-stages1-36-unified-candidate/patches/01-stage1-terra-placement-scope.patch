+++ b/common/api/src/main/java/com/dfsek/terra/api/world/PlacementScope.java
@@ -0,0 +1,17 @@
+package com.dfsek.terra.api.world;
+
+/** Savepoint for a single Terra structure placement. */
+public interface PlacementScope extends AutoCloseable {
+    void commit();
+    void abort();
+    @Override void close();
+
+    static PlacementScope noop() {
+        return new PlacementScope() {
+            private boolean closed;
+            @Override public void commit() { closed = true; }
+            @Override public void abort() { closed = true; }
+            @Override public void close() { if (!closed) abort(); }
+        };
+    }
+}

