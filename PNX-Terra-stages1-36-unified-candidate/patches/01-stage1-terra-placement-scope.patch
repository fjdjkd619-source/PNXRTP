+package com.dfsek.terra.api.world;
+
+import com.dfsek.terra.api.util.Rotation;
+import com.dfsek.terra.api.util.vector.Vector3Int;
+
+/** Stable identity inputs for a Terra placement. */
+public record PlacementDescriptor(String featureId, String structureId, Vector3Int origin, Rotation rotation) {
+    public PlacementDescriptor {
+        if (featureId == null || featureId.isBlank()) throw new IllegalArgumentException("featureId must not be blank");
+        if (structureId == null || structureId.isBlank()) throw new IllegalArgumentException("structureId must not be blank");
+        if (origin == null || rotation == null) throw new NullPointerException("origin and rotation are required");
+    }
+
+    public PlacementDescriptor offset(int x, int y, int z) {
+        return new PlacementDescriptor(featureId, structureId,
+                Vector3Int.of(origin.getX() + x, origin.getY() + y, origin.getZ() + z), rotation);
+    }
+}

