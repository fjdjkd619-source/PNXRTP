+package com.dfsek.terra.api.world;
+
+/**
+ * A savepoint for one structure placement. Implementations must make close()
+ * abort an uncommitted scope. Nested commits must merge into the parent scope,
+ * not publish writes independently.
+ */
+public interface PlacementScope extends AutoCloseable {
+    void commit();
+
+    void abort();
+
+    @Override
+    void close();
+
+    static PlacementScope noop() {
+        return new PlacementScope() {
+            private boolean closed;
+
+            @Override
+            public void commit() {
+                closed = true;
+            }
+
+            @Override
+            public void abort() {
+                closed = true;
+            }
+
+            @Override
+            public void close() {
+                if(!closed) {
+                    abort();
+                }
+            }
+        };
+    }
+}
