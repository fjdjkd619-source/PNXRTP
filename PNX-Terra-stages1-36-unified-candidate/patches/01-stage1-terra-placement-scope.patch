+package com.dfsek.terra.api.world;
+
+/**
+ * Optional platform hook for transactional structure placement.
+ * Worlds which do not implement this interface retain Terra's existing behavior.
+ */
+public interface PlacementScopeProvider {
+    PlacementScope beginPlacement(PlacementDescriptor descriptor);
+}
