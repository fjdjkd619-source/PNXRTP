@@ -0,0 +1,32 @@
+package com.dfsek.terra.api.world;
+
+import com.dfsek.seismic.type.Rotation;
+import com.dfsek.seismic.type.vector.Vector3Int;
+
+/**
+ * Stable identity inputs for a placement. The platform adapter combines these
+ * with the world seed to create its deterministic placement key.
+ */
+public record PlacementDescriptor(
+    String featureId,
+    String structureId,
+    Vector3Int origin,
+    Rotation rotation
+) {
+    public PlacementDescriptor {
+        if(featureId == null || featureId.isBlank()) {
+            throw new IllegalArgumentException("featureId must not be blank");
+        }
+        if(structureId == null || structureId.isBlank()) {
+            throw new IllegalArgumentException("structureId must not be blank");
+        }
+        if(origin == null || rotation == null) {
+            throw new NullPointerException("origin and rotation are required");
+        }
+    }
+
+    public PlacementDescriptor offset(int x, int y, int z) {
+        return new PlacementDescriptor(featureId, structureId,
+            Vector3Int.of(origin.getX() + x, origin.getY() + y, origin.getZ() + z), rotation);
+    }
+}
