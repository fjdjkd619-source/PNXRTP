@@ -0,0 +1,98 @@
+package org.powernukkitx.terra.crosschunk;
+
+import org.powernukkitx.terra.crosschunk.transaction.PlacementTransactionCoordinator;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.atomic.AtomicReference;
+
+public final class ChunkSealLedgerTest {
+    public static void main(String[] args) throws Exception {
+        Path dir = Files.createTempDirectory("terra-seal-test");
+        Path sealFile = dir.resolve("sealed.wal");
+        Path journalFile = dir.resolve("placements.wal");
+        ChunkPos sealed = new ChunkPos(2, -3);
+        PlacementKey key = PlacementKey.create(9L, "overworld", "test:feature", "test:castle", 32, 70, -48, 0, "root");
+
+        try (CrossChunkPlacementJournal journal = new CrossChunkPlacementJournal(journalFile);
+             ChunkSealLedger seals = new ChunkSealLedger(sealFile)) {
+            PlacementTransactionCoordinator<byte[]> coordinator = new PlacementTransactionCoordinator<>(
+                    journal, bytes -> bytes.clone(),
+                    (placementKey, operations) -> seals.appendIfUnsealed(operations,
+                            () -> journal.append(placementKey, operations)));
+
+            var accepted = coordinator.begin(key, 0, CrossChunkOperation.ConflictPolicy.EXCLUSIVE);
+            accepted.write(31, 70, -48, 0, new byte[]{1});
+            accepted.commit();
+            if (journal.operationsForChunk(1, -3).size() != 1) throw new AssertionError("pre-seal placement missing");
+
+            seals.seal(sealed);
+            if (!seals.isSealed(sealed)) throw new AssertionError("chunk was not sealed");
+            var rejected = coordinator.begin(PlacementKey.create(9L, "overworld", "test:feature", "test:late", 40, 70, -48, 0, "root"),
+                    0, CrossChunkOperation.ConflictPolicy.EXCLUSIVE);
+            rejected.write(32, 70, -48, 0, new byte[]{2});
+            boolean failedClosed = false;
+            try {
+                rejected.commit();
+            } catch (IOException expected) {
+                failedClosed = expected.getMessage().contains("finalized chunk");
+            }
+            if (!failedClosed) throw new AssertionError("late write to sealed chunk was not rejected");
+            rejected.abort();
+            if (!journal.operationsForChunk(2, -3).isEmpty()) throw new AssertionError("rejected placement leaked to journal");
+        }
+
+        // The seal must survive a process restart and discard a torn tail.
+        Files.write(sealFile, new byte[]{0x50, 0x54, 0x58}, java.nio.file.StandardOpenOption.APPEND);
+        try (ChunkSealLedger recovered = new ChunkSealLedger(sealFile)) {
+            if (!recovered.isSealed(sealed)) throw new AssertionError("seal did not recover");
+            boolean idempotent = !recovered.seal(sealed);
+            if (!idempotent) throw new AssertionError("recovered seal was not idempotent");
+        }
+        if (Files.size(sealFile) != 18L) throw new AssertionError("torn seal-ledger tail was not truncated");
+
+        // A commit already inside the guard must finish before sealing can pass;
+        // a later commit must then be rejected. This tests the shared monitor.
+        Path raceFile = dir.resolve("race-sealed.wal");
+        try (ChunkSealLedger race = new ChunkSealLedger(raceFile)) {
+            CountDownLatch appendEntered = new CountDownLatch(1);
+            CountDownLatch releaseAppend = new CountDownLatch(1);
+            AtomicReference<Throwable> failure = new AtomicReference<>();
+            Thread commit = new Thread(() -> {
+                try {
+                    race.appendIfUnsealed(List.of(new CrossChunkOperation(48, 70, 0, 0, 0,
+                            CrossChunkOperation.ConflictPolicy.ALLOW, key, 0, new byte[]{3})), () -> {
+                        appendEntered.countDown();
+                        try { releaseAppend.await(); }
+                        catch (InterruptedException interrupted) {
+                            Thread.currentThread().interrupt();
+                            throw new IOException(interrupted);
+                        }
+                        return true;
+                    });
+                } catch (Throwable t) { failure.set(t); }
+            });
+            commit.start();
+            appendEntered.await();
+            Thread seal = new Thread(() -> {
+                try { race.seal(new ChunkPos(3, 0)); }
+                catch (Throwable t) { failure.set(t); }
+            });
+            seal.start();
+            releaseAppend.countDown();
+            commit.join();
+            seal.join();
+            if (failure.get() != null) throw new AssertionError("race failed", failure.get());
+            boolean rejectedAfterSeal = false;
+            try {
+                race.appendIfUnsealed(List.of(new CrossChunkOperation(49, 70, 0, 0, 0,
+                        CrossChunkOperation.ConflictPolicy.ALLOW, key, 1, new byte[]{4})), () -> true);
+            } catch (IOException expected) { rejectedAfterSeal = true; }
+            if (!rejectedAfterSeal) throw new AssertionError("post-seal concurrent commit was accepted");
+        }
+        System.out.println("ChunkSealLedgerTest: PASS");
+    }
+}
