@@ -0,0 +1,149 @@
+package org.powernukkitx.terra.crosschunk;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.channels.FileLock;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.Collection;
+import java.util.HashSet;
+import java.util.Objects;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.zip.CRC32C;
+
+/**
+ * Durable finalization barrier for target chunks.
+ *
+ * A sealed chunk is immutable from the Terra placement journal's perspective:
+ * a new placement that would write into it is rejected before its WAL frame is
+ * published. This is deliberately fail-closed until the dependency scheduler
+ * proves that every possible source/anchor chunk has completed.
+ */
+@SuppressWarnings("try")
+public final class ChunkSealLedger implements AutoCloseable {
+    private static final int MAGIC = 0x50545853; // PTXS
+    private static final short VERSION = 1;
+    private static final int BODY_BYTES = Integer.BYTES * 2;
+    private static final int FRAME_BYTES = Integer.BYTES + Short.BYTES + BODY_BYTES + Integer.BYTES;
+
+    @FunctionalInterface
+    public interface JournalAppend {
+        boolean append() throws IOException;
+    }
+
+    private final FileChannel channel;
+    private final Set<ChunkPos> sealed = new HashSet<>();
+    private boolean closed;
+
+    public ChunkSealLedger(Path file) throws IOException {
+        Path path = Objects.requireNonNull(file, "file").toAbsolutePath();
+        Path parent = path.getParent();
+        if (parent != null) Files.createDirectories(parent);
+        if (!Files.exists(path)) Files.createFile(path);
+        recover(path);
+        channel = FileChannel.open(path, StandardOpenOption.READ, StandardOpenOption.WRITE);
+        channel.position(channel.size());
+    }
+
+    /**
+     * Atomically validates all target chunks and publishes one placement frame.
+     * The same monitor protects seal(), so a placement cannot race between the
+     * unsealed check and its durable journal append.
+     */
+    public synchronized boolean appendIfUnsealed(Collection<CrossChunkOperation> operations,
+                                                   JournalAppend append) throws IOException {
+        ensureOpen();
+        Objects.requireNonNull(operations, "operations");
+        Objects.requireNonNull(append, "append");
+        TreeSet<ChunkPos> targets = new TreeSet<>((a, b) -> {
+            int x = Integer.compare(a.x(), b.x());
+            return x != 0 ? x : Integer.compare(a.z(), b.z());
+        });
+        for (CrossChunkOperation operation : operations) {
+            targets.add(new ChunkPos(operation.targetChunkX(), operation.targetChunkZ()));
+        }
+        for (ChunkPos target : targets) {
+            if (sealed.contains(target)) {
+                throw new IOException("Terra placement targets finalized chunk " + target
+                        + "; refusing a late cross-chunk write");
+            }
+        }
+        return append.append();
+    }
+
+    /** Durably seals a target chunk. Repeated calls are idempotent. */
+    public synchronized boolean seal(ChunkPos chunk) throws IOException {
+        ensureOpen();
+        Objects.requireNonNull(chunk, "chunk");
+        if (sealed.contains(chunk)) return false;
+        ByteBuffer body = ByteBuffer.allocate(BODY_BYTES).putInt(chunk.x()).putInt(chunk.z());
+        body.flip();
+        CRC32C crc = new CRC32C();
+        crc.update(body.asReadOnlyBuffer());
+        ByteBuffer frame = ByteBuffer.allocate(FRAME_BYTES);
+        frame.putInt(MAGIC).putShort(VERSION).put(body).putInt((int) crc.getValue()).flip();
+        try (FileLock ignored = channel.lock()) {
+            channel.position(channel.size());
+            while (frame.hasRemaining()) channel.write(frame);
+            channel.force(true);
+        }
+        sealed.add(chunk);
+        return true;
+    }
+
+    public synchronized boolean isSealed(ChunkPos chunk) {
+        ensureOpen();
+        return sealed.contains(Objects.requireNonNull(chunk, "chunk"));
+    }
+
+    private void recover(Path path) throws IOException {
+        try (FileChannel read = FileChannel.open(path, StandardOpenOption.READ, StandardOpenOption.WRITE)) {
+            long size = read.size(), offset = 0, validEnd = 0;
+            ByteBuffer frame = ByteBuffer.allocate(FRAME_BYTES);
+            while (offset < size) {
+                frame.clear();
+                int total = 0;
+                while (frame.hasRemaining()) {
+                    int count = read.read(frame, offset + total);
+                    if (count <= 0) break;
+                    total += count;
+                }
+                if (total < FRAME_BYTES) break;
+                frame.flip();
+                int magic = frame.getInt();
+                short version = frame.getShort();
+                int x = frame.getInt(), z = frame.getInt();
+                int expectedCrc = frame.getInt();
+                ByteBuffer body = ByteBuffer.allocate(BODY_BYTES).putInt(x).putInt(z);
+                body.flip();
+                CRC32C crc = new CRC32C();
+                crc.update(body);
+                if (magic != MAGIC || version != VERSION || (int) crc.getValue() != expectedCrc) {
+                    throw new IOException("Invalid chunk-seal ledger frame at byte " + offset);
+                }
+                sealed.add(new ChunkPos(x, z));
+                offset += FRAME_BYTES;
+                validEnd = offset;
+            }
+            if (validEnd != size) {
+                read.truncate(validEnd);
+                read.force(true);
+            }
+        }
+    }
+
+    private void ensureOpen() {
+        if (closed) throw new IllegalStateException("Chunk seal ledger is closed");
+    }
+
+    @Override
+    public synchronized void close() throws IOException {
+        if (!closed) {
+            closed = true;
+            channel.close();
+        }
+    }
+}
