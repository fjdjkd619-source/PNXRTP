+
+    /**
+     * Finalizes one target chunk before PNX marks it FINISHED/sendable. The
+     * durable seal is written first and atomically excludes later placement
+     * commits targeting this chunk. The current journal snapshot is then
+     * applied, synchronously persisted with LevelDB sync=true, and only then
+     * acknowledged in the applied-chunk ledger.
+     */
+    public int finalizeChunk(org.powernukkitx.level.Level level, IChunk chunk) throws IOException {
+        Objects.requireNonNull(level, "level");
+        Objects.requireNonNull(chunk, "chunk");
+        ChunkPos position = new ChunkPos(chunk.getX(), chunk.getZ());
+        seals.seal(position);
+        if (level.getChunkIfLoaded(position.x(), position.z()) != chunk) {
+            throw new IOException("Chunk changed before Terra finalization: " + position);
+        }
+        PnxJournalChunkApplier applier = new PnxJournalChunkApplier(level, journal, ledger,
+                Block::canBeReplaced, Runnable::run);
+        int applied = applier.applyAvailableToChunk(chunk);
+        byte[] digest = ChunkOperationDigest.calculate(journal.operationsForChunk(position.x(), position.z()));
+        if (!(level.getProvider() instanceof LevelDBProvider provider)) {
+            throw new IOException("Durable Terra finalization requires the PNX LevelDB provider; found "
+                    + level.getProvider().getClass().getName());
+        }
+        if (level.getChunkIfLoaded(position.x(), position.z()) != chunk) {
+            throw new IOException("Chunk unloaded before durable Terra save: " + position);
+        }
+        provider.getStorage().writeChunkDurable(chunk);
+        if (!seals.isSealed(position)) {
+            throw new IOException("Chunk seal disappeared during finalization: " + position);
+        }
+        ledger.markApplied(position, digest);
+        return applied;
+    }
