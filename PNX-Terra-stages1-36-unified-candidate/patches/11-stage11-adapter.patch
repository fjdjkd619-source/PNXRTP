+package org.powernukkitx.terra.crosschunk.pnx;
+
+import org.powernukkitx.level.Level;
+import org.powernukkitx.level.format.FakeChunk;
+import org.powernukkitx.level.format.leveldb.LevelDBStorage;
+import org.powernukkitx.terra.crosschunk.ChunkOperationDigest;
+import org.powernukkitx.terra.crosschunk.ChunkPos;
+import org.powernukkitx.terra.crosschunk.runtime.TerraCrossChunkRuntime;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+public final class Stage11FinalizationContractTest {
+    public static void main(String[] args) throws Exception {
+        Path world = Files.createTempDirectory("terra-stage11-world");
+        Level level = new Level();
+        FakeChunk chunk = new FakeChunk(4, -2);
+        Level.loaded = chunk;
+        // Point the LevelProvider stub at an isolated test directory.
+        System.setProperty("stage11.world", world.toString());
+        TerraCrossChunkRuntime runtime = TerraCrossChunkRuntime.forLevel(level);
+        ChunkPos position = new ChunkPos(4, -2);
+        byte[] emptyDigest = ChunkOperationDigest.calculate(runtime.journal().operationsForChunk(4, -2));
+
+        LevelDBStorage.FAIL = true;
+        boolean saveFailed = false;
+        try {
+            runtime.finalizeChunk(level, chunk);
+        } catch (java.io.IOException expected) {
+            saveFailed = true;
+        }
+        if (!saveFailed) throw new AssertionError("injected durable save failure was ignored");
+        if (runtime.ledger().isApplied(position, emptyDigest)) {
+            throw new AssertionError("failed chunk save was acknowledged");
+        }
+        if (!runtime.seals().isSealed(position)) {
+            throw new AssertionError("chunk must remain sealed after a failed save");
+        }
+
+        LevelDBStorage.FAIL = false;
+        runtime.finalizeChunk(level, chunk);
+        if (!runtime.ledger().isApplied(position, emptyDigest)) {
+            throw new AssertionError("successful durable save was not acknowledged");
+        }
+        if (LevelDBStorage.SAVES.get() != 1) throw new AssertionError("unexpected durable save count");
+        TerraCrossChunkRuntime.closeAll();
+        System.out.println("Stage11FinalizationContractTest: PASS");
+    }
+}
