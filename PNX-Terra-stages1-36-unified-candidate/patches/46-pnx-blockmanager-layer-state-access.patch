+    /**
+     * Returns a staged or loaded block state from the requested Bedrock layer without
+     * forcing a chunk load. The cache is authoritative for in-progress Terra placements.
+     */
+    public BlockState getBlockStateAt(int x, int y, int z, int layer) {
+        Block cached = this.caches.get(hashXYZ(x, y, z, layer));
+        if (cached != null) {
+            return cached.getBlockState();
+        }
+        if (!level.isChunkLoaded(x >> 4, z >> 4)) {
+            return BlockAir.STATE;
+        }
+        return level.getBlockStateAt(x, y, z, layer);
+    }
+
+    public BlockState getBlockStateAt(int x, int y, int z) {
+        return getBlockStateAt(x, y, z, 0);
+    }
