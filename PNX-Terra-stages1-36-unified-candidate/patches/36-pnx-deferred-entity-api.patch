+    /** Construct an entity for a durable generation transaction without registering or scheduling it. */
+    @Nullable
+    public static Entity createEntityForGeneration(@NotNull String identifier, @NotNull IChunk chunk,
+                                                   @NotNull CompoundTag nbt) {
