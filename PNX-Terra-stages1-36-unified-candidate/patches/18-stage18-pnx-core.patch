+    /** Recovery is allowed only when the WAL contains a durable, incomplete anchor-start marker. */
+    public boolean generateChunkToStage(int x, int z, String targetStage, boolean recoverIncomplete) {
+        if (targetStage == null || targetStage.isBlank()) {
+            throw new IllegalArgumentException("targetStage must be non-empty");
+        }
+        long index = Level.chunkHash(x, z);
+        if (this.chunkGenerationQueue.containsKey(index)) {
+            IChunk inFlight = this.getChunkIfLoaded(x, z);
+            if (inFlight != null && inFlight.getChunkState().ordinal() >= ChunkState.POPULATED.ordinal()) {
+                return true;
+            }
+            this.pendingChunkGenerationStages.put(index, targetStage);
+            return true;
+        }
+        if (this.chunkGenerationQueue.size() >= this.chunkGenerationQueueSize) {
+            return false;
+        }
+        if (this.chunkGenerationQueue.putIfAbsent(index, Boolean.TRUE) == null) {
+            final IChunk chunk = this.getChunk(x, z, true);
+            if (chunk == null) {
+                this.chunkGenerationQueue.remove(index);
+                return false;
+            }
+            if (chunk.getChunkState().canSend()) {
+                if (!recoverIncomplete) {
+                    this.chunkGenerationQueue.remove(index);
+                    throw new IllegalStateException("Refusing to repopulate a finished chunk without a durable incomplete-anchor marker: " + x + "," + z);
+                }
+                chunk.setChunkState(ChunkState.GENERATED);
+                chunk.setChanged();
+            }
+            this.generator.asyncGenerate(chunk, targetStage, (c) -> {
+                chunkGenerationQueue.remove(c.getChunk().getIndex());
+                resumePendingGenerationStage(index, x, z, c.getChunk());
+            });
+            return true;
+        }
+        this.pendingChunkGenerationStages.put(index, targetStage);
+        return true;
+    }
+
+    private void resumePendingGenerationStage(long index, int x, int z, IChunk completed) {
+        String requestedStage = this.pendingChunkGenerationStages.remove(index);
+        if (requestedStage != null
+                && completed.getChunkState().ordinal() < ChunkState.POPULATED.ordinal()
+                && !completed.getChunkState().canSend()) {
+            this.generateChunkToStage(x, z, requestedStage);
+        }
+    }
