+
+    @Override
+    public void setBlockState(int x, int y, int z, BlockState blockState, boolean physics) {
+        PlacementTransaction tx = requirePlacement();
+        tx.guard.beforeWrite(x, y, z);
+        if (physics) tx.physics.add(new PhysicsIntent(x, y, z, true));
+
+        var innerBlockState = ((PNXBlockStateDelegate) blockState).innerBlockState();
+        Block old = readOldBlock(tx, x, y, z);
+        String oldBaseId = old.getId();
+        BlockVector3 stagedPosition = new BlockVector3(x, y, z);
+        boolean layerOneAvailable = tx.staged.isCached(stagedPosition, 1)
+                || level.getLevel().isChunkLoaded(x >> 4, z >> 4);
+        String oldLayerOneId = layerOneAvailable
+                ? tx.staged.getBlockIdAt(x, y, z, 1) : "minecraft:air";
+        boolean oldLayerOneFluid = isWaterIdentifier(oldLayerOneId);
+        boolean oldBaseFluid = isWaterIdentifier(oldBaseId);
+        boolean previousFluid = oldLayerOneFluid || oldBaseFluid;
+
+        String identifier = innerBlockState.getIdentifier();
+        boolean intrinsicWaterPlant = isIntrinsicWaterPlant(identifier);
+        boolean explicitWaterlogged = false;
+        boolean hasWaterloggedProperty = false;
+        for (var property : innerBlockState.getBlockPropertyValues()) {
+            if ("waterlogged".equals(property.getPropertyType().getName())) {
+                hasWaterloggedProperty = true;
+                explicitWaterlogged = Boolean.parseBoolean(String.valueOf(property.getValue()));
+                break;
+            }
+        }
+        boolean supportsWaterlogging = innerBlockState.toBlock().getWaterloggingLevel() > 0;
+        boolean waterlogged = hasWaterloggedProperty
+                ? explicitWaterlogged
+                : supportsWaterlogging && previousFluid;
+
+        byte[] canonicalWaterState;
+        try {
+            var waterState = PNXProtoChunk.water;
+            if (oldLayerOneFluid) {
+                waterState = tx.staged.getBlockStateAt(x, y, z, 1);
+            } else if (oldBaseFluid) {
+                waterState = old.getBlockState();
+            }
+            canonicalWaterState = PnxBlockStateCodec.encode(waterState);
+        } catch (IOException invalidWaterState) {
+            throw new IllegalStateException("Could not encode the canonical/preserved PNX water state", invalidWaterState);
+        }
+
+        WaterLayerPolicy.Result water = WaterLayerPolicy.resolve(identifier,
+                intrinsicWaterPlant, waterlogged, canonicalWaterState);
+        boolean newStateIsLiquid = isWaterIdentifier(identifier);
+        tx.staged.setBlockStateAt(x, y, z, innerBlockState);
+        if (water.writeWaterLayer() && !newStateIsLiquid) {
+            try {
+                tx.staged.setBlockStateAt(x, y, z, 1, PnxBlockStateCodec.decode(water.canonicalWaterState()));
+            } catch (IOException invalidWaterState) {
+                throw new IllegalStateException("Could not decode canonical PNX water layer state", invalidWaterState);
+            }
+        } else if (oldLayerOneFluid) {
+            // Clear stale liquid only; preserve unrelated Bedrock layer-one content.
+            tx.staged.setBlockStateAt(x, y, z, 1, BlockAir.STATE);
+        }
+    }
+
+    private static boolean isWaterIdentifier(String identifier) {
+        return Objects.equals(identifier, BlockID.WATER)
+                || Objects.equals(identifier, BlockID.FLOWING_WATER);
+    }
+
+    private static boolean isIntrinsicWaterPlant(String identifier) {
+        return Objects.equals(identifier, BlockID.KELP)
+                || "minecraft:seagrass".equals(identifier)
+                || "minecraft:tall_seagrass".equals(identifier);
+    }
+
+    private Block readOldBlock(PlacementTransaction tx, int x, int y, int z) {
+        BlockVector3 position = new BlockVector3(x, y, z);
+        PlacementTransaction cachedIn = findCached(tx, position);
+        boolean inBatch = level.isCached(position);
+        boolean loaded = level.getLevel().isChunkLoaded(x >> 4, z >> 4);
+        tx.guard.beforeImplicitWriteRead(x, y, z, cachedIn != null || inBatch || loaded);
+        if (cachedIn != null) return cachedIn.staged.getCachedBlock(x, y, z);
+        if (inBatch) return level.getCachedBlock(x, y, z);
+        return level.getBlockIfCachedOrLoaded(x, y, z);
+    }
+
+    @Override
+    public Entity spawnEntity(double x, double y, double z, EntityType entityType) {
+        PlacementTransaction tx = requirePlacement();
+        tx.guard.beforeEntitySpawn((int) Math.floor(x), (int) Math.floor(y), (int) Math.floor(z));
+        if (tx.journalTicket == null || tx.journalKey == null) {
+            throw new IllegalStateException("Entity spawning requires the durable placement journal");
+        }
+        Object handle = entityType == null ? null : entityType.getHandle();
+        if (!(handle instanceof String identifier)
+                || !identifier.matches("[a-z0-9_.-]+:[a-z0-9_./-]+")) {
+            throw new IllegalArgumentException("Terra entity type must expose a canonical namespaced PNX identifier");
+        }
+        PNXStagedEntityDelegate staged = new PNXStagedEntityDelegate(identifier, x, y, z, this, tx.guard);
+        tx.entitySpawns.add(staged);
+        return staged;
+    }
+
+    @Override
+    public BlockState getBlockState(int x, int y, int z) {
+        PlacementTransaction tx = requirePlacement();
+        BlockVector3 position = new BlockVector3(x, y, z);
+        PlacementTransaction cachedIn = findCached(tx, position);
+        boolean inBatch = level.isCached(position);
+        boolean loaded = level.getLevel().isChunkLoaded(x >> 4, z >> 4);
+        tx.guard.beforeRead(x, y, z, cachedIn != null || inBatch || loaded);
+        if (cachedIn != null) return PNXAdapter.adapt(cachedIn.staged.getCachedBlock(x, y, z).getBlockState());
+        if (inBatch) return PNXAdapter.adapt(level.getCachedBlock(x, y, z).getBlockState());
+        return PNXAdapter.adapt(level.getBlockIfCachedOrLoaded(x, y, z).getBlockState());
+    }
+
+    private PlacementTransaction findCached(PlacementTransaction from, BlockVector3 position) {
+        for (PlacementTransaction cursor = from; cursor != null; cursor = cursor.parent) {
+            if (cursor.staged.isCached(position)) return cursor;
+        }
+        return null;
+    }
+
+    private PlacementTransaction requirePlacement() {
+        PlacementTransaction tx = activePlacement;
+        if (tx == null) throw new IllegalStateException("Terra block operation outside a guarded root placement");
+        if (Thread.currentThread() != tx.owner) throw new IllegalStateException("Placement accessed from another thread");
+        return tx;
+    }
+
+    @Override
+    public BlockEntity getBlockEntity(int x, int y, int z) {
+        if (y < getMinHeight() || y >= getMaxHeight())
+            throw new IllegalArgumentException("Block entity read outside world height: " + y);
+        PlacementTransaction transaction = activePlacement;
+        if (transaction != null) {
+            if (Thread.currentThread() != transaction.owner)
+                throw new IllegalStateException("Block entity read from another thread during placement");
+            BlockVector3 position = new BlockVector3(x, y, z);
+            PlacementTransaction cachedIn = findCached(transaction, position);
+            boolean inBatch = level.isCached(position);
+            boolean loaded = level.getLevel().isChunkLoaded(x >> 4, z >> 4);
+            transaction.guard.beforeRead(x, y, z, cachedIn != null || inBatch || loaded);
+            Block block = cachedIn != null ? cachedIn.staged.getCachedBlock(x, y, z)
+                    : inBatch ? level.getCachedBlock(x, y, z)
+                    : loaded ? level.getBlockIfCachedOrLoaded(x, y, z) : null;
+            if ((cachedIn != null || inBatch) && block instanceof BlockEntityHolder<?> holder) {
+                Class<? extends org.powernukkitx.blockentity.BlockEntity> blockEntityClass = holder.getBlockEntityClass();
+                if (blockEntityClass != null) {
+                    String type = holder.getBlockEntityType();
+                    CompoundTag initial = new CompoundTag();
+                    if (BlockEntitySign.class.isAssignableFrom(blockEntityClass)) {
+                        return new PNXStagedSignDelegate(x, y, z, type, PNXAdapter.adapt(block.getBlockState()),
+                                initial, intent -> recordBlockEntityIntent(transaction, intent));
+                    }
+                    if (BlockEntityMobSpawner.class.isAssignableFrom(blockEntityClass)) {
+                        return new PNXStagedMobSpawnerDelegate(x, y, z, type, PNXAdapter.adapt(block.getBlockState()),
+                                initial, intent -> recordBlockEntityIntent(transaction, intent));
+                    }
+                    if (BlockEntityInventoryHolder.class.isAssignableFrom(blockEntityClass)) {
+                        int inventorySize = stagedInventorySize(blockEntityClass);
+                        return new PNXStagedContainerDelegate(x, y, z, type, PNXAdapter.adapt(block.getBlockState()),
+                                initial, inventorySize, null,
+                                intent -> recordBlockEntityIntent(transaction, intent));
+                    }
+                }
+            }
+        }
+        IChunk chunk = level.getLevel().getChunkIfLoaded(x >> 4, z >> 4);
+        if (chunk == null || !chunk.isLoaded() || !chunk.isInitiated()) {
+            throw new IllegalStateException("Terra requested a block entity from an unloaded/uninitiated chunk; refusing force-load at "
+                    + x + "," + y + "," + z);
+        }
+        org.powernukkitx.blockentity.BlockEntity blockEntity = chunk.getTile(x & 15, y, z & 15);
+        return blockEntity == null ? null : new PNXBlockEntityDelegate(blockEntity);
+    }
+
+    private static int stagedInventorySize(Class<? extends org.powernukkitx.blockentity.BlockEntity> type) {
+        String name = type.getSimpleName().toLowerCase(java.util.Locale.ROOT);
+        if (name.contains("chest") || name.contains("barrel") || name.contains("shulker")) return 27;
+        if (name.contains("dispenser") || name.contains("dropper") || name.contains("crafter")) return 9;
+        if (name.contains("hopper")) return 5;
+        if (name.contains("brewingstand")) return 5;
+        if (name.contains("furnace") || name.contains("smoker")) return 3;
+        throw new UnsupportedOperationException("No safe Terra inventory size mapping for PNX BlockEntity " + type.getName());
+    }
+
+    private static void recordBlockEntityIntent(PlacementTransaction transaction, BlockEntityIntent intent) {
+        transaction.guard.beforeWrite(intent.x(), intent.y(), intent.z());
+        transaction.blockEntities.removeIf(existing -> existing.x() == intent.x()
+                && existing.y() == intent.y() && existing.z() == intent.z());
+        transaction.blockEntities.add(intent);
+    }
+
+    @Override public ChunkGenerator getGenerator() { return generatorWrapper.getHandle(); }
+    @Override public BiomeProvider getBiomeProvider() { return generatorWrapper.getBiomeProvider(); }
+    @Override public ConfigPack getPack() { return generatorWrapper.getConfigPack(); }
+    @Override public long getSeed() { return level.getSeed(); }
+    @Override public int getMaxHeight() { return generatorWrapper.getDimensionData().getMaxHeight(); }
+    @Override public int getMinHeight() { return generatorWrapper.getDimensionData().getMinHeight(); }
+    @Override public Level getHandle() { return level.getLevel(); }
+    @Override public Chunk getChunkAt(int x, int z) {
+        // Level.getChunk(x,z) calls forceLoadChunk when the chunk is absent, even with create=false.
+        // Terra's guarded placement path must never synchronously load a neighbour from a worker.
+        IChunk chunk = level.getLevel().getChunkIfLoaded(x, z);
+        if (chunk == null || !chunk.isLoaded() || !chunk.isInitiated()) {
+            throw new IllegalStateException("Terra requested an unloaded/uninitiated chunk; refusing force-load at "
+                    + x + "," + z);
+        }
+        return new PNXChunkDelegate(this, chunk);
+    }
+
+    private record PlacementTransaction(String featureId, String structureId, int originX, int originY, int originZ,
+                                        PlacementRuntimeGuard guard, BlockManager staged, PlacementTransaction parent,
+                                        List<BlockEntityIntent> blockEntities, List<PhysicsIntent> physics,
+                                        List<PNXStagedEntityDelegate> entitySpawns,
+                                        PlacementGuardContext.Scope guardScope, Thread owner,
+                                        CrossChunkDependencyScheduler.PlacementTicket journalTicket, PlacementKey journalKey) { }
+}
