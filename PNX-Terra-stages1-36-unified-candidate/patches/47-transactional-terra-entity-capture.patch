-    private Block readOldBlock(PlacementTransaction tx, int x, int y, int z) {
-        BlockVector3 position = new BlockVector3(x, y, z);
-        PlacementTransaction cachedIn = findCached(tx, position);
-        boolean inBatch = level.isCached(position);
-        boolean loaded = level.getLevel().isChunkLoaded(x >> 4, z >> 4);
-        tx.guard.beforeImplicitWriteRead(x, y, z, cachedIn != null || inBatch || loaded);
-        if (cachedIn != null) return cachedIn.staged.getCachedBlock(x, y, z);
-        if (inBatch) return level.getCachedBlock(x, y, z);
-        return level.getBlockIfCachedOrLoaded(x, y, z);
-    }
