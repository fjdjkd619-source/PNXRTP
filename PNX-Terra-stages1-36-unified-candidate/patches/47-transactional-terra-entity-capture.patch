+    /** Begin a root feature placement. Unknown profiles and entity-bearing profiles fail closed. */
+    public PlacementGuardHost.PlacementScope beginPlacement(String featureId, String structureId,
+                                                             Vector3Int origin, Rotation rotation) {
+        if (activePlacement != null) {
+            throw new IllegalStateException("A root Terra placement is already active on this world adapter");
+        }
+        ScriptBoundsProfile profile;
+        try {
+            profile = OrigenBoundsCatalog.resolveRuntimeProfile(structureId);
+        } catch (IllegalArgumentException invalidId) {
+            publishUnsupported(featureId, structureId, origin, "Structure has no usable identifier; placement skipped");
+            return PlacementGuardHost.PlacementScope.rejected();
+        }
+        Bounds3i.QuarterTurn turn = switch (rotation) {
+            case NONE -> Bounds3i.QuarterTurn.NONE;
+            // Seismic's CW_90 maps (x,z)->(z,-x), opposite the guard's CW label.
+            case CW_90 -> Bounds3i.QuarterTurn.COUNTERCLOCKWISE_90;
+            case CW_180 -> Bounds3i.QuarterTurn.HALF;
+            case CCW_90 -> Bounds3i.QuarterTurn.CLOCKWISE_90;
+        };
+        PlacementRuntimeGuard guard = new PlacementRuntimeGuard(profile, origin.getX(), origin.getY(), origin.getZ(), turn);
+        PlacementGuardContext.Scope guardScope = PlacementGuardContext.installRoot(guard);
+        CrossChunkDependencyScheduler.PlacementTicket journalTicket = anchorSession == null ? null : anchorSession.beginPlacement();
+        PlacementKey journalKey = anchorSession == null ? null : new PlacementKey(worldKey, level.getSeed(),
+                anchorSession.anchor(), featureId, structureId,
+                origin.getX(), origin.getY(), origin.getZ(), turn.ordinal(), journalTicket.ordinal());
+        PlacementTransaction root = new PlacementTransaction(featureId, structureId, origin.getX(), origin.getY(), origin.getZ(),
+                guard, new BlockManager(level.getLevel()), null, new ArrayList<>(), new ArrayList<>(),
+                new ArrayList<>(), guardScope, Thread.currentThread(), journalTicket, journalKey);
+        activePlacement = root;
+        return scopeFor(root, true);
+    }
+
+
+    private void publishUnsupported(String featureId, String structureId, Vector3Int origin, String message) {
+        diagnostics.publish(new GenerationDiagnostic(Instant.now(), GenerationDiagnostic.Severity.WARNING,
+                "terra_populate", featureId, structureId,
+                new ChunkPos(origin.getX() >> 4, origin.getZ() >> 4), origin.getX(), origin.getY(), origin.getZ(),
+                message, "none"));
+    }
+
+    /** Nested TerraScript structures are savepoints under the same root guard and envelope. */
+    public PlacementGuardHost.PlacementScope beginNestedPlacement(String structureId) {
+        PlacementTransaction parent = requirePlacement();
+        if (structureId == null || !parent.guard.profile().allowsNestedStructure(structureId)) {
+            return PlacementGuardHost.PlacementScope.rejected();
+        }
+        PlacementTransaction child = new PlacementTransaction(parent.featureId, structureId,
+                parent.originX, parent.originY, parent.originZ, parent.guard, new BlockManager(level.getLevel()), parent,
+                new ArrayList<>(), new ArrayList<>(), new ArrayList<>(), null, parent.owner, null, null);
+        activePlacement = child;
+        return scopeFor(child, false);
+    }
+
+    private PlacementGuardHost.PlacementScope scopeFor(PlacementTransaction transaction, boolean root) {
+        return new PlacementGuardHost.PlacementScope() {
+            private boolean finished;
+
+            @Override public boolean accepted() { return !finished && activePlacement == transaction; }
+
+            @Override
+            public boolean commit() {
+                ensureOwner();
+                if (finished) return false;
+                if (transaction.guard.snapshot().state() != PlacementRuntimeGuard.State.OPEN) {
+                    abort();
+                    return false;
+                }
+                if (!root) {
+                    transaction.parent.staged.merge(transaction.staged);
+                    transaction.parent.blockEntities.addAll(transaction.blockEntities);
+                    transaction.parent.physics.addAll(transaction.physics);
+                    transaction.parent.entitySpawns.addAll(transaction.entitySpawns);
+                    finish();
+                    return true;
+                }
+                int anchorChunkX = transaction.originX >> 4;
+                int anchorChunkZ = transaction.originZ >> 4;
+                if (transaction.journalTicket == null) {
+                    // Legacy construction remains fail-closed until the PopulateStage journal service is supplied.
+                    if (!transaction.blockEntities.isEmpty() || !transaction.physics.isEmpty()
+                            || !transaction.entitySpawns.isEmpty()) { abort(); return false; }
+                    for (Block block : transaction.staged.getBlocks()) {
+                        if (block.getChunkX() != anchorChunkX || block.getChunkZ() != anchorChunkZ) {
+                            abort();
+                            return false;
+                        }
+                    }
+                    level.merge(transaction.staged);
+                } else if (transaction.staged.getBlocks().isEmpty()
+                        && transaction.blockEntities.isEmpty() && transaction.physics.isEmpty()
+                        && transaction.entitySpawns.isEmpty()) {
+                    transaction.journalTicket.abort();
+                } else {
