+    public void apply(IChunk chunk) {
+        // The WAL owns cross-chunk writes. This stage-local manager may contain only anchor writes.
+        // Never force-load a neighbouring chunk from this generation worker; Stage18 applies WAL projections.
+        for (Block block : level.getBlocks()) {
+            if (block.getChunkX() != chunk.getX() || block.getChunkZ() != chunk.getZ()) {
+                throw new IllegalStateException("Cross-chunk Terra writes reached PNX apply before journal integration");
+            }
+        }
