-    @Override
-    public BlockEntity getBlockEntity(int x, int y, int z) {
-        if (y < getMinHeight() || y >= getMaxHeight())
-            throw new IllegalArgumentException("Block entity read outside world height: " + y);
-        PlacementTransaction transaction = activePlacement;
-        if (transaction != null) {
-            if (Thread.currentThread() != transaction.owner)
