-    private static void recordBlockEntityIntent(PlacementTransaction transaction, BlockEntityIntent intent) {
-        transaction.guard.beforeWrite(intent.x(), intent.y(), intent.z());
-        transaction.blockEntities.removeIf(existing -> existing.x() == intent.x()
-                && existing.y() == intent.y() && existing.z() == intent.z());
-        transaction.blockEntities.add(intent);
-    }
