index 0000000000000000000000000000000000000000..7f20389d43e72e1944eb7c5a8053f6061808435d
--- /dev/null
+++ b/src/main/java/org/powernukkitx/terra/crosschunk/FeatureWriteBounds.java
@@ -0,0 +1,57 @@
+package org.powernukkitx.terra.crosschunk;
+
+import java.util.Objects;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * Declared horizontal write bounds relative to a feature's anchor.
+ * Bounds must include every nested structure, decorator, and block-entity write.
+ * Vertical bounds are intentionally omitted because chunk scheduling is X/Z based.
+ */
+public record FeatureWriteBounds(
+        String featureId,
+        int minOffsetX, int maxOffsetX,
+        int minOffsetZ, int maxOffsetZ) {
+
+    public FeatureWriteBounds {
+        Objects.requireNonNull(featureId, "featureId");
+        if (featureId.isBlank()) throw new IllegalArgumentException("featureId must not be blank");
+        if (minOffsetX > maxOffsetX || minOffsetZ > maxOffsetZ)
+            throw new IllegalArgumentException("Invalid feature write bounds");
+    }
+
+    /**
+     * Finds every source/anchor chunk that could place any block into target.
+     * This is exact for anchors anywhere inside a source chunk and the declared
+     * rectangular bounds. It uses long arithmetic to avoid int overflow.
+     */
+    public Set<ChunkPos> sourceChunksForTarget(ChunkPos target) {
+        Objects.requireNonNull(target, "target");
+        long targetMinX = (long) target.x() * 16L;
+        long targetMaxX = targetMinX + 15L;
+        long targetMinZ = (long) target.z() * 16L;
+        long targetMaxZ = targetMinZ + 15L;
+
+        // anchor + [minOffset,maxOffset] intersects target block rectangle
+        long anchorMinX = targetMinX - maxOffsetX;
+        long anchorMaxX = targetMaxX - minOffsetX;
+        long anchorMinZ = targetMinZ - maxOffsetZ;
+        long anchorMaxZ = targetMaxZ - minOffsetZ;
+
+        long minChunkX = Math.floorDiv(anchorMinX, 16L);
+        long maxChunkX = Math.floorDiv(anchorMaxX, 16L);
+        long minChunkZ = Math.floorDiv(anchorMinZ, 16L);
+        long maxChunkZ = Math.floorDiv(anchorMaxZ, 16L);
+        if (minChunkX < Integer.MIN_VALUE || maxChunkX > Integer.MAX_VALUE
+                || minChunkZ < Integer.MIN_VALUE || maxChunkZ > Integer.MAX_VALUE)
+            throw new IllegalArgumentException("Feature bounds exceed supported chunk coordinates");
+
+        long count = (maxChunkX - minChunkX + 1L) * (maxChunkZ - minChunkZ + 1L);
+        if (count > 1_000_000L) throw new IllegalArgumentException("Feature dependency halo is unreasonably large: " + count);
+        Set<ChunkPos> result = new TreeSet<>();
+        for (long x = minChunkX; x <= maxChunkX; x++)
+            for (long z = minChunkZ; z <= maxChunkZ; z++) result.add(new ChunkPos((int) x, (int) z));
+        return Set.copyOf(result);
+    }
+}
diff --git a/src/main/java/org/powernukkitx/terra/crosschunk/GenerationBarrierCoordinator.java b/src/main/java/org/powernukkitx/terra/crosschunk/GenerationBarrierCoordinator.java
new file mode 100644
index 0000000000000000000000000000000000000000..75c67c4c3d49f44b35880406430e3a82117ff06d
--- /dev/null
+++ b/src/main/java/org/powernukkitx/terra/crosschunk/GenerationBarrierCoordinator.java
@@ -0,0 +1,139 @@
+package org.powernukkitx.terra.crosschunk;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.concurrent.CompletableFuture;
+
+/**
+ * Non-blocking generation dependency coordinator.
+ *
+ * The scheduler must request/schedule every source chunk in a target's dependency
+ * set, then call sourcePopulationComplete only after that source's full feature
+ * population has committed its placement journal entries. The target may be
+ * finalized only after its returned future completes. No worker thread waits.
+ */
+public final class GenerationBarrierCoordinator {
+    public record BarrierTicket(ChunkPos target, List<ChunkPos> dependencies) {
+        public BarrierTicket {
+            Objects.requireNonNull(target, "target");
+            dependencies = List.copyOf(dependencies);
+        }
+    }
+
+    private final Map<ChunkPos, Throwable> failedSources = new HashMap<>();
+    private final Set<ChunkPos> completedSources = new HashSet<>();
+    private final Map<ChunkPos, List<Waiter>> waitersBySource = new HashMap<>();
+
+    /** Build the dependency halo from all enabled feature write bounds. */
+    public static List<ChunkPos> dependenciesFor(ChunkPos target, Collection<FeatureWriteBounds> bounds) {
+        Objects.requireNonNull(target, "target");
+        Objects.requireNonNull(bounds, "bounds");
+        Set<ChunkPos> dependencies = new TreeSet<>();
+        for (FeatureWriteBounds feature : bounds) dependencies.addAll(feature.sourceChunksForTarget(target));
+        dependencies.add(target); // target's own feature pass is always part of the barrier
+        return dependencies.stream().sorted().toList();
+    }
+
+    /**
+     * Returns immediately with a future. The future completes when all source
+     * chunks have completed feature population; failures propagate exceptionally.
+     */
+    public CompletableFuture<BarrierTicket> awaitTarget(
+            ChunkPos target, Collection<FeatureWriteBounds> enabledBounds) {
+        List<ChunkPos> dependencies = dependenciesFor(target, enabledBounds);
+        CompletableFuture<BarrierTicket> future = new CompletableFuture<>();
+        List<Throwable> failures = new ArrayList<>();
+        synchronized (this) {
+            for (ChunkPos source : dependencies) {
+                Throwable failure = failedSources.get(source);
+                if (failure != null) failures.add(failure);
+            }
+            if (!failures.isEmpty()) {
+                future.completeExceptionally(failures.get(0));
+                return future;
+            }
+            List<ChunkPos> pending = dependencies.stream().filter(source -> !completedSources.contains(source)).toList();
+            if (pending.isEmpty()) {
+                future.complete(new BarrierTicket(target, dependencies));
+                return future;
+            }
+            Waiter waiter = new Waiter(target, dependencies, new HashSet<>(pending), future);
+            for (ChunkPos source : pending)
+                waitersBySource.computeIfAbsent(source, ignored -> new ArrayList<>()).add(waiter);
+        }
+        return future;
+    }
+
+    /** Call only after all feature placements originating in source are durably committed. */
+    public void sourcePopulationComplete(ChunkPos source) {
+        Objects.requireNonNull(source, "source");
+        List<Waiter> affected;
+        synchronized (this) {
+            if (failedSources.containsKey(source)) throw new IllegalStateException("Source chunk already failed: " + source);
+            if (!completedSources.add(source)) return;
+            affected = waitersBySource.remove(source);
+        }
+        if (affected == null) return;
+        for (Waiter waiter : affected) {
+            boolean ready;
+            synchronized (this) {
+                waiter.pending.remove(source);
+                ready = waiter.pending.isEmpty() && !waiter.future.isDone();
+            }
+            if (ready) waiter.future.complete(new BarrierTicket(waiter.target, waiter.dependencies));
+        }
+    }
+
+    /** A failed source prevents dependent targets from being finalized as complete. */
+    public void sourcePopulationFailed(ChunkPos source, Throwable failure) {
+        Objects.requireNonNull(source, "source");
+        Objects.requireNonNull(failure, "failure");
+        List<Waiter> affected;
+        synchronized (this) {
+            if (completedSources.contains(source)) throw new IllegalStateException("Source chunk already completed: " + source);
+            failedSources.putIfAbsent(source, failure);
+            affected = waitersBySource.remove(source);
+        }
+        if (affected != null) {
+            for (Waiter waiter : affected) {
+                waiter.future.completeExceptionally(failure);
+                removeWaiterFromOtherSources(waiter, source);
+            }
+        }
+    }
+
+    /** Snapshot useful for diagnostics; never used as a readiness substitute. */
+    public synchronized Set<ChunkPos> completedSourcesSnapshot() { return Set.copyOf(completedSources); }
+
+    private void removeWaiterFromOtherSources(Waiter waiter, ChunkPos failedSource) {
+        synchronized (this) {
+            for (ChunkPos source : waiter.pending) {
+                if (source.equals(failedSource)) continue;
+                List<Waiter> list = waitersBySource.get(source);
+                if (list != null) {
+                    list.remove(waiter);
+                    if (list.isEmpty()) waitersBySource.remove(source);
+                }
+            }
+            waiter.pending.clear();
+        }
+    }
+
+    private static final class Waiter {
+        final ChunkPos target;
+        final List<ChunkPos> dependencies;
+        final Set<ChunkPos> pending;
+        final CompletableFuture<BarrierTicket> future;
+        Waiter(ChunkPos target, List<ChunkPos> dependencies, Set<ChunkPos> pending,
+               CompletableFuture<BarrierTicket> future) {
+            this.target = target; this.dependencies = dependencies; this.pending = pending; this.future = future;
+        }
+    }
+}
diff --git a/src/main/java/org/powernukkitx/terra/crosschunk/PlacementKey.java b/src/main/java/org/powernukkitx/terra/crosschunk/PlacementKey.java
new file mode 100644
index 0000000000000000000000000000000000000000..12ad383ca7df2672e78b870b9f4deb544f75beec
--- /dev/null
+++ b/src/main/java/org/powernukkitx/terra/crosschunk/PlacementKey.java
@@ -0,0 +1,77 @@
+package org.powernukkitx.terra.crosschunk;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.HexFormat;
+import java.util.Objects;
+
+/**
+ * Stable identity of one logical structure placement. All inputs must be
+ * deterministic and independent of generation-thread scheduling.
+ */
+public final class PlacementKey implements Comparable<PlacementKey> {
+    private static final byte[] DOMAIN = "PNX-TERRA-PLACEMENT-V1".getBytes(StandardCharsets.UTF_8);
+    private final byte[] value;
+
+    private PlacementKey(byte[] value) {
+        if (value.length != 32) throw new IllegalArgumentException("SHA-256 key must be 32 bytes");
+        this.value = value.clone();
+    }
+
+    public static PlacementKey create(long worldSeed, String dimensionId,
+                                      String featureId, String structureId,
+                                      int anchorX, int anchorY, int anchorZ,
+                                      int rotation, String nestedPath) {
+        Objects.requireNonNull(dimensionId, "dimensionId");
+        Objects.requireNonNull(featureId, "featureId");
+        Objects.requireNonNull(structureId, "structureId");
+        Objects.requireNonNull(nestedPath, "nestedPath");
+        try {
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            digest.update(DOMAIN);
+            putLong(digest, worldSeed);
+            putString(digest, dimensionId);
+            putString(digest, featureId);
+            putString(digest, structureId);
+            putInt(digest, anchorX);
+            putInt(digest, anchorY);
+            putInt(digest, anchorZ);
+            putInt(digest, rotation);
+            putString(digest, nestedPath);
+            return new PlacementKey(digest.digest());
+        } catch (NoSuchAlgorithmException impossible) {
+            throw new AssertionError("SHA-256 is required by the Java runtime", impossible);
+        }
+    }
+
+    public static PlacementKey fromBytes(byte[] bytes) { return new PlacementKey(bytes); }
+    public byte[] bytes() { return value.clone(); }
+    public String hex() { return HexFormat.of().formatHex(value); }
+
+    @Override public int compareTo(PlacementKey other) {
+        for (int i = 0; i < value.length; i++) {
+            int a = value[i] & 0xff, b = other.value[i] & 0xff;
+            if (a != b) return Integer.compare(a, b);
+        }
+        return 0;
+    }
+    @Override public boolean equals(Object other) {
+        return other instanceof PlacementKey key && MessageDigest.isEqual(value, key.value);
+    }
+    @Override public int hashCode() { return ByteBuffer.wrap(value).getInt(); }
+    @Override public String toString() { return hex(); }
+
+    private static void putString(MessageDigest d, String value) {
+        byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        putInt(d, bytes.length);
+        d.update(bytes);
+    }
+    private static void putInt(MessageDigest d, int value) {
+        d.update(ByteBuffer.allocate(Integer.BYTES).putInt(value).array());
+    }
+    private static void putLong(MessageDigest d, long value) {
+        d.update(ByteBuffer.allocate(Long.BYTES).putLong(value).array());
+    }
+}
diff --git a/src/main/java/org/powernukkitx/terra/crosschunk/pnx/PnxBlockStatePayloadCodec.java b/src/main/java/org/powernukkitx/terra/crosschunk/pnx/PnxBlockStatePayloadCodec.java
new file mode 100644
index 0000000000000000000000000000000000000000..feac98ddefcb209748181cc15bc1611709d9012d
--- /dev/null
+++ b/src/main/java/org/powernukkitx/terra/crosschunk/pnx/PnxBlockStatePayloadCodec.java
@@ -0,0 +1,74 @@
+package org.powernukkitx.terra.crosschunk.pnx;
+
+import org.powernukkitx.block.BlockProperties;
+import org.powernukkitx.block.BlockState;
+import org.powernukkitx.registry.Registries;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.util.Objects;
+
+/**
+ * Stable, registry-aware payload for a PNX BlockState.
+ *
+ * The payload deliberately stores identifier + specialValue, not the runtime
+ * block-state hash. The hash is an implementation detail and is not a durable
+ * cross-version identifier. The receiving server must use the same registered
+ * block definitions; unknown identifiers/states fail closed.
+ */
+public final class PnxBlockStatePayloadCodec {
+    private static final int MAGIC = 0x504E5853; // PNXS
+    private static final short VERSION = 1;
+    private static final int MAX_IDENTIFIER_CHARS = 512;
+
+    private PnxBlockStatePayloadCodec() {}
+
+    public static byte[] encode(BlockState state) throws IOException {
+        Objects.requireNonNull(state, "state");
+        String identifier = Objects.requireNonNull(state.getIdentifier(), "state identifier");
+        if (identifier.isBlank() || identifier.length() > MAX_IDENTIFIER_CHARS) {
+            throw new IOException("Invalid PNX block identifier length");
+        }
+        BlockProperties properties = Registries.BLOCK.getBlockProperties(identifier);
+        if (properties == null || !properties.containBlockState(state)) {
+            throw new IOException("Block state is not canonical in the active PNX registry: " + identifier);
+        }
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream(64);
+        try (DataOutputStream out = new DataOutputStream(bytes)) {
+            out.writeInt(MAGIC);
+            out.writeShort(VERSION);
+            out.writeUTF(identifier);
+            out.writeShort(state.specialValue());
+        }
+        return bytes.toByteArray();
+    }
+
+    public static BlockState decode(byte[] payload) throws IOException {
+        Objects.requireNonNull(payload, "payload");
+        if (payload.length < 10 || payload.length > 1024) {
+            throw new IOException("Invalid PNX block-state payload length");
+        }
+        try (DataInputStream in = new DataInputStream(new ByteArrayInputStream(payload))) {
+            if (in.readInt() != MAGIC) throw new IOException("Invalid PNX block-state payload magic");
+            if (in.readShort() != VERSION) throw new IOException("Unsupported PNX block-state payload version");
+            String identifier = in.readUTF();
+            if (identifier.isBlank() || identifier.length() > MAX_IDENTIFIER_CHARS) {
+                throw new IOException("Invalid PNX block identifier");
+            }
+            short specialValue = in.readShort();
+            if (in.available() != 0) throw new IOException("Trailing bytes in PNX block-state payload");
+            BlockProperties properties = Registries.BLOCK.getBlockProperties(identifier);
+            if (properties == null) throw new IOException("Unregistered PNX block identifier: " + identifier);
+            BlockState state = properties.getBlockState(specialValue);
+            if (state == null || !identifier.equals(state.getIdentifier())) {
+                throw new IOException("Unknown PNX block-state value for " + identifier + ": " + specialValue);
+            }
+            return state;
+        } catch (IllegalArgumentException malformed) {
+            throw new IOException("Malformed PNX block-state payload", malformed);
+        }
+    }
+}
diff --git a/src/main/java/org/powernukkitx/terra/crosschunk/pnx/PnxJournalChunkApplier.java b/src/main/java/org/powernukkitx/terra/crosschunk/pnx/PnxJournalChunkApplier.java
new file mode 100644
index 0000000000000000000000000000000000000000..8a6a4304c9f2472aea423a7dac9b6ceb993d7dab
--- /dev/null
+++ b/src/main/java/org/powernukkitx/terra/crosschunk/pnx/PnxJournalChunkApplier.java
@@ -0,0 +1,176 @@
+package org.powernukkitx.terra.crosschunk.pnx;
+
+import org.powernukkitx.block.Block;
+import org.powernukkitx.block.BlockState;
+import org.powernukkitx.level.Level;
+import org.powernukkitx.level.format.IChunk;
+import org.powernukkitx.level.generator.object.BlockManager;
+import org.powernukkitx.terra.crosschunk.AppliedChunkLedger;
+import org.powernukkitx.terra.crosschunk.ChunkOperationDigest;
+import org.powernukkitx.terra.crosschunk.ChunkPos;
+import org.powernukkitx.terra.crosschunk.CrossChunkOperation;
+import org.powernukkitx.terra.crosschunk.CrossChunkPlacementJournal;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.Executor;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.function.Predicate;
+
+/**
+ * Applies the durable journal snapshot to an already-loaded/generated PNX chunk.
+ * It never requests or force-loads a target chunk. Persistence is injected so
+ * the PNX integration can use its actual provider save path and acknowledge
+ * only after that save has completed successfully.
+ */
+public final class PnxJournalChunkApplier {
+    @FunctionalInterface
+    public interface ChunkPersister {
+        CompletableFuture<Void> persist(IChunk chunk);
+    }
+
+    public record ApplyResult(ChunkPos chunk, int operationsApplied, byte[] snapshotDigest) {
+        public ApplyResult {
+            snapshotDigest = snapshotDigest.clone();
+        }
+        @Override public byte[] snapshotDigest() { return snapshotDigest.clone(); }
+    }
+
+    private final Level level;
+    private final CrossChunkPlacementJournal journal;
+    private final AppliedChunkLedger ledger;
+    private final Predicate<Block> replaceable;
+    private final Executor generationExecutor;
+    private final ConcurrentHashMap<ChunkPos, CompletableFuture<Void>> tails = new ConcurrentHashMap<>();
+
+    public PnxJournalChunkApplier(Level level, CrossChunkPlacementJournal journal,
+                                  AppliedChunkLedger ledger, Predicate<Block> replaceable,
+                                  Executor generationExecutor) {
+        this.level = Objects.requireNonNull(level, "level");
+        this.journal = Objects.requireNonNull(journal, "journal");
+        this.ledger = Objects.requireNonNull(ledger, "ledger");
+        this.replaceable = Objects.requireNonNull(replaceable, "replaceable");
+        this.generationExecutor = Objects.requireNonNull(generationExecutor, "generationExecutor");
+    }
+
+    /**
+     * Serializes applications per target chunk. If new placements arrive while
+     * the previous snapshot is being persisted, it takes and applies the newer
+     * snapshot before completing. Failed persistence leaves the ledger
+     * unacknowledged, so retry safely replays the idempotent snapshot.
+     */
+    public CompletableFuture<ApplyResult> applyLatest(ChunkPos target, ChunkPersister persister) {
+        Objects.requireNonNull(target, "target");
+        Objects.requireNonNull(persister, "persister");
+        AtomicReference<CompletableFuture<ApplyResult>> result = new AtomicReference<>();
+        tails.compute(target, (key, priorTail) -> {
+            CompletableFuture<Void> base = priorTail == null
+                    ? CompletableFuture.completedFuture(null)
+                    : priorTail.handle((ignored, failure) -> null);
+            CompletableFuture<ApplyResult> operation = base.thenComposeAsync(ignored -> applyUntilStable(key, persister), generationExecutor);
+            result.set(operation);
+            return operation.handle((ignored, failure) -> null);
+        });
+        return result.get();
+    }
+
+    private CompletableFuture<ApplyResult> applyUntilStable(ChunkPos target, ChunkPersister persister) {
+        final List<CrossChunkOperation> snapshot = journal.operationsForChunk(target.x(), target.z());
+        final byte[] digest = ChunkOperationDigest.calculate(snapshot);
+        if (ledger.isApplied(target, digest)) {
+            return CompletableFuture.completedFuture(new ApplyResult(target, 0, digest));
+        }
+
+        final IChunk chunk = level.getChunkIfLoaded(target.x(), target.z());
+        if (chunk == null) {
+            return CompletableFuture.failedFuture(new IllegalStateException(
+                    "Target chunk is not loaded; refusing to force-load " + target));
+        }
+        if (!chunk.isGenerated() || !chunk.isInitiated()) {
+            return CompletableFuture.failedFuture(new IllegalStateException(
+                    "Target chunk is not generated and initialized: " + target));
+        }
+
+        final int applied;
+        try {
+            applied = applySnapshot(chunk, snapshot);
+        } catch (Throwable failure) {
+            return CompletableFuture.failedFuture(failure);
+        }
+
+        CompletableFuture<Void> persisted;
+        try {
+            persisted = Objects.requireNonNull(persister.persist(chunk), "persister returned null future");
+        } catch (Throwable failure) {
+            return CompletableFuture.failedFuture(failure);
+        }
+        return persisted.thenComposeAsync(ignored -> {
+            try {
+                ledger.markApplied(target, digest);
+            } catch (IOException failure) {
+                return CompletableFuture.failedFuture(failure);
+            }
+            byte[] currentDigest = ChunkOperationDigest.calculate(
+                    journal.operationsForChunk(target.x(), target.z()));
+            if (!java.security.MessageDigest.isEqual(digest, currentDigest)) {
+                return applyUntilStable(target, persister);
+            }
+            return CompletableFuture.completedFuture(new ApplyResult(target, applied, digest));
+        }, generationExecutor);
+    }
+
+    private int applySnapshot(IChunk chunk, List<CrossChunkOperation> operations) throws IOException {
+        if (operations.isEmpty()) return 0;
+        Map<BlockLayer, List<CrossChunkOperation>> candidates = new HashMap<>();
+        for (CrossChunkOperation operation : operations) {
+            if (operation.targetChunkX() != chunk.getX() || operation.targetChunkZ() != chunk.getZ()) {
+                throw new IOException("Journal returned operation for the wrong target chunk");
+            }
+            if (operation.y() < chunk.getDimensionData().getMinHeight()
+                    || operation.y() > chunk.getDimensionData().getMaxHeight()) {
+                throw new IOException("Journal operation is outside dimension height: " + operation.y());
+            }
+            candidates.computeIfAbsent(new BlockLayer(operation.x(), operation.y(), operation.z(), operation.layer()),
+                    ignored -> new ArrayList<>()).add(operation);
+        }
+
+        synchronized (chunk) {
+        if (level.getChunkIfLoaded(chunk.getX(), chunk.getZ()) != chunk) {
+            throw new IOException("Target chunk was unloaded before journal application: " + chunk.getX() + "," + chunk.getZ());
+        }
+        BlockManager manager = new BlockManager(level);
+        int applied = 0;
+        List<Map.Entry<BlockLayer, List<CrossChunkOperation>>> ordered = new ArrayList<>(candidates.entrySet());
+        ordered.sort(Map.Entry.comparingByKey(Comparator.comparingInt(BlockLayer::x)
+                .thenComparingInt(BlockLayer::y).thenComparingInt(BlockLayer::z).thenComparingInt(BlockLayer::layer)));
+        for (var entry : ordered) {
+            BlockLayer position = entry.getKey();
+            BlockState baseState = chunk.getBlockState(position.x() & 15, position.y(), position.z() & 15, position.layer());
+            Block baseBlock = Block.get(baseState, level, position.x(), position.y(), position.z(), position.layer());
+            boolean canReplace = replaceable.test(baseBlock);
+            var winner = CrossChunkPlacementJournal.resolveWinner(entry.getValue(), canReplace);
+            if (winner.isEmpty()) continue;
+            BlockState targetState = PnxBlockStatePayloadCodec.decode(winner.get().statePayload());
+            manager.setBlockStateAt(position.x(), position.y(), position.z(), position.layer(), targetState);
+            applied++;
+        }
+        manager.applySubChunkUpdate();
+        return applied;
+        }
+    }
+
+    /** Remove an idle tail after the caller has completed chunk unload. */
+    public boolean forget(ChunkPos chunk) {
+        CompletableFuture<Void> tail = tails.get(chunk);
+        return tail == null || (tail.isDone() && tails.remove(chunk, tail));
+    }
+
+    private record BlockLayer(int x, int y, int z, int layer) {}
+}
diff --git a/src/test/java/org/powernukkitx/terra/crosschunk/ChunkGenerationRequestCoordinatorTest.java b/src/test/java/org/powernukkitx/terra/crosschunk/ChunkGenerationRequestCoordinatorTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..cdc180f79238bbd99ea77a7f3f29466a42c8f725
--- /dev/null
+++ b/src/test/java/org/powernukkitx/terra/crosschunk/ChunkGenerationRequestCoordinatorTest.java
@@ -0,0 +1,150 @@
+package org.powernukkitx.terra.crosschunk;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicInteger;
+
+public final class ChunkGenerationRequestCoordinatorTest {
+    public static void main(String[] args) {
+        coalescesAndExtendsTarget();
+        concurrentBurstUsesSinglePipeline();
+        skipsDurablyCompletedPhases();
+        failedPhaseCanBeRetried();
+        idleSlotCanBeForgotten();
+        System.out.println("PASS: request coalescing, target extension, completed-phase skip, retry, unload cleanup");
+    }
+
+    private static void coalescesAndExtendsTarget() {
+        ChunkPos pos = new ChunkPos(-3, 7);
+        ManualDriver driver = new ManualDriver();
+        ChunkGenerationRequestCoordinator coordinator = new ChunkGenerationRequestCoordinator(driver);
+        CompletableFuture<Void> generated = coordinator.request(pos, ChunkGenerationRequestCoordinator.Phase.GENERATED);
+        CompletableFuture<Void> populated = coordinator.request(pos, ChunkGenerationRequestCoordinator.Phase.POPULATED);
+        CompletableFuture<Void> finalized = coordinator.request(pos, ChunkGenerationRequestCoordinator.Phase.FINALIZED);
+        check(driver.calls(pos) == 1, "only TERRAIN should be running initially");
+        check(driver.phases(pos).equals(List.of(ChunkGenerationRequestCoordinator.Phase.TERRAIN)), "first phase order");
+        driver.completeNext(pos);
+        check(driver.phases(pos).get(1) == ChunkGenerationRequestCoordinator.Phase.GENERATED, "generated phase follows terrain");
+        driver.completeNext(pos);
+        check(generated.isDone() && !populated.isDone() && !finalized.isDone(), "waiters complete at their own requested phase");
+        driver.completeNext(pos);
+        driver.completeNext(pos);
+        check(populated.isDone() && !finalized.isDone(), "populate waiter completes without waiting for finalization");
+        driver.completeNext(pos);
+        finalized.join();
+        check(driver.phases(pos).equals(List.of(
+                ChunkGenerationRequestCoordinator.Phase.TERRAIN,
+                ChunkGenerationRequestCoordinator.Phase.GENERATED,
+                ChunkGenerationRequestCoordinator.Phase.STRUCTURES,
+                ChunkGenerationRequestCoordinator.Phase.POPULATED,
+                ChunkGenerationRequestCoordinator.Phase.FINALIZED)), "each phase runs exactly once in order");
+    }
+
+    private static void concurrentBurstUsesSinglePipeline() {
+        ChunkPos pos = new ChunkPos(-120, 85);
+        ManualDriver driver = new ManualDriver();
+        ChunkGenerationRequestCoordinator coordinator = new ChunkGenerationRequestCoordinator(driver);
+        ExecutorService pool = Executors.newFixedThreadPool(8);
+        try {
+            List<Future<CompletableFuture<Void>>> submissions = new ArrayList<>();
+            ChunkGenerationRequestCoordinator.Phase[] phases = ChunkGenerationRequestCoordinator.Phase.values();
+            for (int i = 0; i < 160; i++) {
+                final var phase = phases[1 + (i % (phases.length - 1))];
+                submissions.add(pool.submit(() -> coordinator.request(pos, phase)));
+            }
+            List<CompletableFuture<Void>> waiters = new ArrayList<>();
+            for (Future<CompletableFuture<Void>> submission : submissions) waiters.add(submission.get());
+            while (waiters.stream().anyMatch(future -> !future.isDone())) driver.completeNext(pos);
+            waiters.forEach(CompletableFuture::join);
+            check(driver.phases(pos).size() == phases.length - 1, "concurrent burst must run each phase exactly once");
+            check(driver.phases(pos).get(driver.phases(pos).size() - 1) == ChunkGenerationRequestCoordinator.Phase.FINALIZED,
+                    "highest concurrent request must extend the shared pipeline");
+        } catch (Exception failure) {
+            throw new AssertionError("concurrent burst failed", failure);
+        } finally {
+            pool.shutdownNow();
+        }
+    }
+
+    private static void skipsDurablyCompletedPhases() {
+        ChunkPos pos = new ChunkPos(0, 0);
+        ManualDriver driver = new ManualDriver();
+        driver.persisted.put(pos, ChunkGenerationRequestCoordinator.Phase.POPULATED);
+        ChunkGenerationRequestCoordinator coordinator = new ChunkGenerationRequestCoordinator(driver);
+        coordinator.request(pos, ChunkGenerationRequestCoordinator.Phase.POPULATED).join();
+        check(driver.calls(pos) == 0, "already populated chunk must not be regenerated");
+        coordinator.request(pos, ChunkGenerationRequestCoordinator.Phase.FINALIZED);
+        check(driver.phases(pos).equals(List.of(ChunkGenerationRequestCoordinator.Phase.FINALIZED)), "resume at next missing phase");
+        driver.completeNext(pos);
+    }
+
+    private static void failedPhaseCanBeRetried() {
+        ChunkPos pos = new ChunkPos(4, -9);
+        ManualDriver driver = new ManualDriver();
+        ChunkGenerationRequestCoordinator coordinator = new ChunkGenerationRequestCoordinator(driver);
+        CompletableFuture<Void> first = coordinator.request(pos, ChunkGenerationRequestCoordinator.Phase.POPULATED);
+        driver.failNext(pos, new IllegalStateException("simulated stage failure"));
+        check(first.isCompletedExceptionally(), "failed phase must fail current waiter");
+        CompletableFuture<Void> retry = coordinator.request(pos, ChunkGenerationRequestCoordinator.Phase.POPULATED);
+        check(driver.calls(pos) == 2, "retry starts from last durably completed phase");
+        while (!retry.isDone()) driver.completeNext(pos);
+        retry.join();
+    }
+
+    private static void idleSlotCanBeForgotten() {
+        ChunkPos pos = new ChunkPos(1, 1);
+        ManualDriver driver = new ManualDriver();
+        ChunkGenerationRequestCoordinator coordinator = new ChunkGenerationRequestCoordinator(driver);
+        coordinator.request(pos, ChunkGenerationRequestCoordinator.Phase.TERRAIN);
+        check(!coordinator.forget(pos), "active slot cannot be forgotten");
+        driver.completeNext(pos);
+        check(coordinator.forget(pos), "idle slot can be forgotten after unload");
+        check(coordinator.trackedChunks() == 0, "forget releases retained slot");
+    }
+
+    private static void check(boolean condition, String message) {
+        if (!condition) throw new AssertionError(message);
+    }
+
+    private static final class ManualDriver implements ChunkGenerationRequestCoordinator.Driver {
+        private final Map<ChunkPos, ChunkGenerationRequestCoordinator.Phase> persisted = new ConcurrentHashMap<>();
+        private final Map<ChunkPos, List<ChunkGenerationRequestCoordinator.Phase>> history = new ConcurrentHashMap<>();
+        private final Map<ChunkPos, List<CompletableFuture<Void>>> pending = new ConcurrentHashMap<>();
+        private final AtomicInteger calls = new AtomicInteger();
+
+        @Override
+        public ChunkGenerationRequestCoordinator.Phase completedPhase(ChunkPos chunk) {
+            return persisted.getOrDefault(chunk, ChunkGenerationRequestCoordinator.Phase.NEW);
+        }
+
+        @Override
+        public CompletableFuture<Void> runPhase(ChunkPos chunk, ChunkGenerationRequestCoordinator.Phase phase) {
+            calls.incrementAndGet();
+            history.computeIfAbsent(chunk, ignored -> new ArrayList<>()).add(phase);
+            CompletableFuture<Void> future = new CompletableFuture<>();
+            pending.computeIfAbsent(chunk, ignored -> new ArrayList<>()).add(future);
+            return future.thenRun(() -> persisted.put(chunk, phase));
+        }
+
+        int calls(ChunkPos chunk) { return history.getOrDefault(chunk, List.of()).size(); }
+        List<ChunkGenerationRequestCoordinator.Phase> phases(ChunkPos chunk) { return history.getOrDefault(chunk, List.of()); }
+
+        void completeNext(ChunkPos chunk) {
+            List<CompletableFuture<Void>> list = pending.get(chunk);
+            CompletableFuture<Void> future = list.remove(0);
+            future.complete(null);
+        }
+
+        void failNext(ChunkPos chunk, Throwable failure) {
+            List<CompletableFuture<Void>> list = pending.get(chunk);
+            list.remove(0).completeExceptionally(failure);
+        }
+    }
+}
diff --git a/src/test/java/org/powernukkitx/terra/crosschunk/CrossChunkDependencySchedulerTest.java b/src/test/java/org/powernukkitx/terra/crosschunk/CrossChunkDependencySchedulerTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..cb6b771dcca34edb7971507ba4bd89a2b4f06e67
