diff --git a/src/main/java/org/powernukkitx/terra/crosschunk/journal/pnx/PnxBlockEntityIntentApplier.java b/src/main/java/org/powernukkitx/terra/crosschunk/journal/pnx/PnxBlockEntityIntentApplier.java
